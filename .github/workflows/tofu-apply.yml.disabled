name: OpenTofu Apply

on:
  push:
    branches: [main]

permissions:
  id-token: write
  contents: read

jobs:
  deploy:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Configure AWS credentials
        uses: aws-actions/configure-aws-credentials@v6
        with:
          role-to-assume: ${{ secrets.AWS_ROLE_ARN }}
          aws-region: us-west-2

      - name: Setup OpenTofu
        uses: opentofu/setup-opentofu@v1

      - name: Login to ECR
        id: ecr
        run: |
          ACCOUNT_ID=$(aws sts get-caller-identity --query Account --output text)
          REGION=us-west-2
          ECR_REGISTRY="${ACCOUNT_ID}.dkr.ecr.${REGION}.amazonaws.com"
          aws ecr get-login-password --region "${REGION}" | \
            docker login --username AWS --password-stdin "${ECR_REGISTRY}"
          echo "registry=${ECR_REGISTRY}" >> "$GITHUB_OUTPUT"

      - name: Ensure ECR repo exists
        run: tofu apply -auto-approve -target=module.bot.aws_ecr_repository.bot -var "image_uri=placeholder"
        working-directory: tofu

      - name: Build and push image
        id: image
        run: |
          IMAGE_URI="${{ steps.ecr.outputs.registry }}/billionaire-matchmaker:${{ github.sha }}"
          docker build -t "${IMAGE_URI}" .
          docker push "${IMAGE_URI}"
          echo "uri=${IMAGE_URI}" >> "$GITHUB_OUTPUT"

      - name: tofu apply
        run: tofu apply -auto-approve -var "image_uri=${{ steps.image.outputs.uri }}"
        working-directory: tofu
